{
  "name": "clientluma",
  "version": "0.1.0",
  "description": "Self-hosted coaching cues for live client calls and recording replays",
  "private": true,
  "main": "server.js",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "tunnel": "node --env-file-if-exists=.env scripts/tunnel.mjs",
    "replay:import": "node --env-file-if-exists=.env scripts/import-replay.mjs",
    "overlay": "npm --prefix overlay start"
  },
  "keywords": ["self-hosted", "meeting-coaching", "meetstream", "transcription"],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@google/genai": "^3.6.1",
    "express": "^4.22.3",
    "mammoth": "^1.13.0",
    "unpdf": "^1.9.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  }
}
