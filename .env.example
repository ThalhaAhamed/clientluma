# AI provider: auto | offline | gemini | claude. Auto uses Gemini first when both keys exist.
# With no key at all, Cuelensa runs on local coaching rules.
# MIA_PROVIDER=gemini

# Gemini (Google AI Studio key)
GEMINI_API_KEY=
# MIA_GEMINI_MODEL=gemini-pro-latest        # knowledge base, report, profile update
# MIA_GEMINI_LIVE_MODEL=gemini-flash-latest # in-call analysis (latency-sensitive)

# Claude
ANTHROPIC_API_KEY=
# MIA_MODEL=claude-opus-5-5
# MIA_LIVE_MODEL=claude-opus-5-5

# MeetStream (optional - for sending a bot into Zoom / Google Meet / Teams)
MEETSTREAM_API_KEY=
# Public https URL of this server so MeetStream can POST live transcripts, e.g. an ngrok tunnel
PUBLIC_URL=
# Secret added to the webhook URLs (MeetStream webhooks are unsigned). Random per start if unset.
# MIA_WEBHOOK_SECRET=

# MeetStream MIA agent (hosted voice agent; "MIA agent" source). Defaults shown.
# Gemini needs your Google key saved in the MeetStream dashboard: Configure > Integrations > Models.
# MIA_AGENT_LLM_PROVIDER=google           # openai | anthropic | google | xai
# MIA_AGENT_LLM_MODEL=gemini-2.5-flash
# MIA_AGENT_LLM_KEY_SOURCE=user           # user = your key in Integrations; meetstream = built-in (OpenAI only)
# MIA_AGENT_STT_PROVIDER=deepgram
# MIA_AGENT_STT_MODEL=nova-3
# MIA_AGENT_STT_KEY_SOURCE=meetstream
# MIA_AGENT_VOICE_PROVIDER=openai         # built-in: openai/tts-1
# MIA_AGENT_VOICE_MODEL=tts-1
# MIA_AGENT_VOICE_KEY_SOURCE=meetstream
# MIA_AGENT_VOICE_ID=alloy
# MIA_AGENT_NAME=MIA
# MIA_AGENT_LANGUAGE=en
# MIA_AGENT_WAKE_WORDS=hey mia,ok mia,mia

# Optional trusted product docs search (Streamable HTTP)
# MIA_DOCS_MCP_URL=https://docs.example.com/mcp
# MIA_DOCS_MCP_TOOL=search_docs
# MIA_DOCS_MCP_QUERY_FIELD=query
# MIA_DOCS_MCP_TOKEN=

# PORT=4000
# MIA_LISTEN_HOST=127.0.0.1         # keep the single-user dashboard on loopback
# MIA_DATA_DIR=./data               # workspace storage and agent configuration
# MIA_DATABASE_NAME=workspace.sqlite
# MIA_DATABASE_PATH=./data/workspace.sqlite
# MIA_DATABASE_PROVIDER=sqlite      # sqlite | postgresql
# MIA_DATABASE_URL=postgresql://<user>:<password>@db.example.com:5432/cuelensa?sslmode=verify-full
# MIA_CALLBACK_PORT=4043           # optional separate loopback port for MeetStream webhooks and voice

# For compose.hosted.yaml, set your public DNS hostname and sign-in credentials.
# MIA_PUBLIC_HOST=calls.example.com
# MIA_HOST_USER=owner
# MIA_HOST_PASSWORD_HASH='paste the bcrypt hash from caddy hash-password'
# MIA_PROXY_TOKEN=                 # random private token, at least 32 characters
# MIA_ANALYZE_EVERY=2               # client utterances per live-analysis pass
# MIA_OFFLINE=1                     # force the offline engine
# MIA_STITCH_MS=1800                # merge adjacent fragments from one speaker
# MIA_SUGGESTION_COOLDOWN_MS=25000  # minimum interval between ordinary cues
# MIA_IDLE_END_MS=180000            # idle call timeout after the first speech
