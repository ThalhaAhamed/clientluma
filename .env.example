# AI provider: gemini | claude. Without it, the first provider with a key is used (Gemini, then Claude).
# With no key at all, ClientLuma runs on local coaching rules.
# MIA_PROVIDER=gemini

# Gemini (Google AI Studio key)
GEMINI_API_KEY=
# MIA_GEMINI_MODEL=gemini-pro-latest        # knowledge base, report, profile update
# MIA_GEMINI_LIVE_MODEL=gemini-flash-latest # in-call analysis (latency-sensitive)

# Claude
ANTHROPIC_API_KEY=
# MIA_MODEL=claude-opus-5-5
# MIA_LIVE_MODEL=claude-opus-5-5

# MeetStream (optional - for sending a bot into Zoom / Google Meet / Teams)
MEETSTREAM_API_KEY=
# Public https URL of this server so MeetStream can POST live transcripts, e.g. an ngrok tunnel
PUBLIC_URL=
# Secret added to the webhook URLs (MeetStream webhooks are unsigned). Random per start if unset.
# MIA_WEBHOOK_SECRET=

# MeetStream MIA agent (hosted voice agent; "MIA agent" source). Defaults shown.
# Gemini needs your Google key saved in the MeetStream dashboard: Configure > Integrations > Models.
# MIA_AGENT_MODE=pipeline                 # pipeline is needed for wake word + speak-only-when-asked
# MIA_AGENT_LLM_PROVIDER=google           # openai | anthropic | google | xai
# MIA_AGENT_LLM_MODEL=gemini-2.5-flash
# MIA_AGENT_LLM_KEY_SOURCE=user           # user = your key in Integrations; meetstream = built-in (OpenAI only)
# MIA_AGENT_STT_PROVIDER=deepgram         # built-in: deepgram/nova-3 or openai/gpt-4o-mini-transcribe
# MIA_AGENT_VOICE_PROVIDER=openai         # built-in: openai/tts-1
# MIA_AGENT_VOICE_ID=alloy
# MIA_AGENT_WAKE_WORDS=hey mia,ok mia,mia

# PORT=4000
# MIA_LISTEN_HOST=127.0.0.1         # keep the single-user dashboard on loopback
# MIA_DATA_DIR=./data               # clients, reports, replays and agent configuration
# MIA_ANALYZE_EVERY=2               # client utterances per live-analysis pass
# MIA_OFFLINE=1                     # force the offline engine
